<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ❓ TANONG: Bakit napakaraming 'uses-permission' dito?
         ✅ SAGOT: Ito ang "Security Contract". Kung wala dito ang permiso,
                  i-ba-block ng Android ang app mo kapag sinubukan nitong
                  gamitin ang GPS o ang Internet. -->

    <!-- Para makapag-report ang app sa Node.js server mo -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Para ma-check muna kung may Wi-Fi o Data bago mag-upload (NetworkUtils) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ❓ TANONG: Ano ang pagkakaiba ng FINE at COARSE location?
         ✅ SAGOT: FINE = Saktong GPS (Street level).
                  COARSE = Tantya lang (City level).
                  Dahil Tracking app tayo, kailangan natin ang FINE location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- ❓ TANONG: Bakit kailangan pa ng ACCESS_BACKGROUND_LOCATION?
         ✅ SAGOT: Ito ang "Universal Fix". Kapag naka-minimize ang app o naka-off ang screen,
                  ito ang nagbibigay ng karapatan sa Service na ituloy ang pag-track. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Para payagan ang app na tumakbo sa background nang hindi pinapatay -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Sinasabi natin sa Android na ang background work natin ay para sa LOCATION -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ❓ TANONG: Bakit kailangan ng POST_NOTIFICATIONS?
         ✅ SAGOT: REQUIREMENT SA ANDROID 13+. Kapag wala ito, hindi lalabas ang
                  notification ng tracking service mo, at papatayin ng Android ang service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para sa QR scanning (CameraX + ML Kit) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".GoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/main_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/main_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Go"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ❓ TANONG: Bakit kailangang 'usesCleartextTraffic="true"'?
             ✅ SAGOT: Dahil ang server natin ay naka-HTTP lang (http://192.168.x.x).
                      Sa modern Android, default na block ang HTTP (gusto nila HTTPS).
                      Ginagawa natin itong 'true' para payagan ang local dev server natin. -->

        <!-- ❓ TANONG: Bakit ang SplashActivity ang may 'intent-filter'?
             ✅ SAGOT: LAUNCHER LOGIC. Ang may hawak ng 'android.intent.action.MAIN'
                      ang siyang unang bubukas na screen kapag clinick ang app icon. -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false">
        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.RegistrationActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.QRScanActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.UpdateInfoActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.TripRegistrationActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.QueueDetailsActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.AssignmentActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.TransitActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.PermissionSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Go"/>

        <!-- ❓ TANONG: Bakit kailangan i-declare ang 'service' dito?
             ✅ SAGOT: Lahat ng component ng Android (Activity, Service)
                      ay dapat rehistrado rito para malaman ng system na bahagi sila ng app.
             ❓ TANONG: Ano ang silbi ng 'foregroundServiceType="location"'?
             ✅ SAGOT: Sinasabi natin sa system: "Huy, huwag mo akong i-hibernate,
                      nagta-track ako ng GPS para sa user." -->
        <service
            android:name=".services.LocationServices"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FileProvider — required for camera intent (MediaStore.ACTION_IMAGE_CAPTURE).
             Supplies content:// URIs that the camera app can write to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".activities.MyTripActivity"
            android:exported="false" />

    </application>

</manifest>
