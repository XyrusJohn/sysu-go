<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:paddingHorizontal="24dp">

    <!-- Warning icon with amber fill — signals caution, not panic -->
    <ImageView
        android:id="@+id/ivDialogIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_warning_amber"
        android:contentDescription="Warning"
        android:layout_marginBottom="14dp" />

    <!-- Title: clear about what action this is -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_title_1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_subtitle"
        android:fontFamily="@font/atkinson_hyperlegible_bold"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Descriptive body — sets expectations of what happens next -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_msg_1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_label"
        android:fontFamily="@font/atkinson_hyperlegible_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Divider separating message from actions -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp" />

    <!-- Dual-action buttons — side by side, equal visual weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Secondary: Dismiss — outlined style, stays quiet -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel_queue_btn_cancel_1"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/corner_radius_button"
            app:strokeColor="@color/border"
            android:textColor="@color/text_secondary" />

        <!-- Primary: Confirm leaving — filled red, signals this is a committing action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_1"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/cancel_queue_btn_confirm_1"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:textAllCaps="false"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>

</LinearLayout>