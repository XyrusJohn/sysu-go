<?xml version="1.0" encoding="utf-8"?>
<!--
  Cancel Queue — Step 2: Final warning (enterprise v2)

  Red destructive icon → title (red, urgent) → message body →
  consequence box (amber) → divider → 2 buttons (Keep spot + Leave anyway).

  Preserves the distinctive consequence warning box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/white"
    android:elevation="10dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="28dp">

    <!-- Red destructive icon — glass circle tinted to match intent -->
    <ImageView
        android:id="@+id/ivDialogIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_dialog_icon_circle"
        android:backgroundTint="@color/sysu_red"
        android:src="@drawable/ic_dialog_destructive"
        android:contentDescription="Final warning"
        android:padding="10dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Title — red for urgency -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_title_2"
        android:textColor="@color/sysu_red"
        android:textSize="@dimen/text_size_body"
        android:fontFamily="@font/atkinson_hyperlegible_bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Main message body -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_msg_2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_label"
        android:fontFamily="@font/atkinson_hyperlegible_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="14dp" />

    <!-- Consequence box — amber background, draws eye to key warning -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_warning_consequence"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_warning_amber"
            android:contentDescription="Important"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel_queue_consequence"
            android:textColor="#E65100"
            android:textSize="@dimen/text_size_label"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginBottom="18dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Secondary: Keep spot — green outlined (safe option) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/cancel_queue_btn_cancel_2"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/corner_radius_button"
            app:strokeColor="@color/sysu_green"
            android:textColor="@color/sysu_green" />

        <!-- Primary: Leave anyway — filled red (destructive) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_2"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/cancel_queue_btn_confirm_2"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>

</LinearLayout>