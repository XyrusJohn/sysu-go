<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:paddingHorizontal="24dp">

    <!-- Red warning icon — signals serious, non-reversible action -->
    <ImageView
        android:id="@+id/ivDialogIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_warning_red"
        android:contentDescription="Warning"
        android:layout_marginBottom="14dp" />

    <!-- Title: consequence in plain language -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_title_2"
        android:textColor="@color/sysu_red"
        android:textSize="@dimen/text_size_subtitle"
        android:fontFamily="@font/atkinson_hyperlegible_bold"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Main message body -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_queue_msg_2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_label"
        android:fontFamily="@font/atkinson_hyperlegible_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="14dp" />

    <!-- Highlighted consequence box — amber background, draws eye to key point -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_warning_consequence"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_warning_amber"
            android:contentDescription="Important"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel_queue_consequence"
            android:textColor="#E65100"
            android:textSize="@dimen/text_size_label"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:gravity="start"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Divider separating from actions -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp" />

    <!-- Dual-action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Secondary: Stay — green-outlined, reassuring calm action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel_queue_btn_cancel_2"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/corner_radius_button"
            app:strokeColor="@color/sysu_green"
            android:textColor="@color/sysu_green" />

        <!-- Primary: Confirm leave — filled red, unambiguous commit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_2"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/cancel_queue_btn_confirm_2"
            android:textSize="@dimen/text_size_button"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:textAllCaps="false"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>

</LinearLayout>