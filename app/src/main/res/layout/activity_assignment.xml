<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- TOP BAR — fixed 72dp, white, no border -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="@dimen/elevation_floating"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:text="My Trip"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/atkinson_hyperlegible_regular"
                    android:text="In transit"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <View
                    android:id="@+id/trackingStateDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_dot_green" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- SCROLLABLE CONTENT — red banner + progress strip + details -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnContainer"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- RED BANNER — 140dp, animated circles + VERIFIED pill + location -->
            <FrameLayout
                android:id="@+id/redBanner"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@color/sysu_red">

                <FrameLayout
                    android:id="@+id/circleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- VERIFIED pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_transit_verified_pill"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="28dp"
                        android:paddingVertical="12dp">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_status_dot_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:letterSpacing="0.15"
                            android:text="VERIFIED"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLocationCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="Acquiring location..."
                        android:textColor="#AAFFFFFF"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </FrameLayout>

            <!-- PROGRESS STRIP — Verified → Transit → Done -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_pill"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp">

                    <!-- Step 1: VERIFIED -->
                    <LinearLayout
                        android:id="@+id/stepQueue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotQueue"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_progress_step_active" />

                            <TextView
                                android:id="@+id/checkQueue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✓"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/numQueue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelQueue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:text="Verified"
                            android:textColor="@color/sysu_red"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Line 1→2 -->
                    <View
                        android:id="@+id/lineQueueToLoading"
                        android:layout_width="36dp"
                        android:layout_height="2dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/divider" />

                    <!-- Step 2: TRANSIT -->
                    <LinearLayout
                        android:id="@+id/stepLoading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotLoading"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_progress_step_pending" />

                            <TextView
                                android:id="@+id/checkLoading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✓"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/numLoading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:text="Transit"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Line 2→3 -->
                    <View
                        android:id="@+id/lineLoadingToTransit"
                        android:layout_width="36dp"
                        android:layout_height="2dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/divider" />

                    <!-- Step 3: DONE -->
                    <LinearLayout
                        android:id="@+id/stepTransit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotTransit"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_progress_step_pending" />

                            <TextView
                                android:id="@+id/checkTransit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✓"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/numTransit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="3"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelTransit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:text="Done"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STATUS LABEL -->
            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:gravity="center"
                android:text="Waiting for truck..."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!-- DETAILS CARD — Shipment Number, Plate, Truck Type, Helper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <!-- Shipment Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/sysu_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/atkinson_hyperlegible_regular"
                            android:text="Shipment Number"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_label" />

                        <TextView
                            android:id="@+id/tvShipmentNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="35dp"
                        android:background="@color/divider" />

                    <!-- Plate Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/sysu_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/atkinson_hyperlegible_regular"
                            android:text="Plate Number"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_label" />

                        <TextView
                            android:id="@+id/tvPlateNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="35dp"
                        android:background="@color/divider" />

                    <!-- Truck Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/sysu_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/atkinson_hyperlegible_regular"
                            android:text="Truck Type"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_label" />

                        <TextView
                            android:id="@+id/tvTruckType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="35dp"
                        android:background="@color/divider" />

                    <!-- Helper -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/sysu_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/atkinson_hyperlegible_regular"
                            android:text="Helper"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_label" />

                        <TextView
                            android:id="@+id/tvHelper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_label"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WARNING NOTIFICATION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/transit_amber"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textColor="@color/transit_amber_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="Keep your phone screen on and connected to the internet while on transit."
                        android:textColor="@color/transit_amber_dark"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BUTTON CONTAINER — fixed at bottom, no scroll -->
    <LinearLayout
        android:id="@+id/btnContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTrip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:text="START TRIP"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button"
            app:elevation="4dp"
            app:strokeWidth="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>