<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="30dp"
            android:src="@drawable/logo_sysu"
            android:scaleType="fitStart"
            android:contentDescription="SYSU Logo" />
    </LinearLayout>

    <!-- RED HEADER (180dp fixed) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/redHeader"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/sysu_red"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/circleContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello Good Day,"
                android:textColor="#E0FFFFFF"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="@font/atkinson_hyperlegible_regular" />

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Name"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title_large"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp"
                app:elevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_status_pill_green">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" />

                    <TextView
                        android:id="@+id/tvStatusBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Online"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_label"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/atkinson_hyperlegible_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/readyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardBackgroundColor="#33FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/readyBadgeDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_light_red"
                        android:backgroundTint="@color/white" />

                    <TextView
                        android:id="@+id/tvReadyBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Ready to Scan"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_label"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/atkinson_hyperlegible_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         QUEUE STATUS CARD — overlaps redHeader by 24dp
         Only top anchor to redHeader. No bottom constraint.
         ══════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQueueStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="-24dp"
        app:cardCornerRadius="@dimen/corner_radius_pill"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/redHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <View
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUEUE STATUS"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/atkinson_hyperlegible_regular"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:baselineAligned="false">

                <ImageView
                    android:id="@+id/ivQueueIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/wait"
                    app:tint="@color/sysu_red"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvQueueStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not In Queue"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_subtitle"
                    android:fontFamily="@font/atkinson_hyperlegible_bold"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="8dp" />

                <TextView
                    android:id="@+id/tvQueueStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/sysu_red"
                    android:textSize="@dimen/text_size_caption"
                    android:fontFamily="@font/atkinson_hyperlegible_bold"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/dividerCancelQueue"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/border"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cancelQueueContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelQueue"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/cancel_queue"
                    android:textSize="@dimen/text_size_label"
                    android:fontFamily="@font/atkinson_hyperlegible_regular"
                    android:textAllCaps="false"
                    android:layout_marginTop="4dp"
                    app:cornerRadius="@dimen/corner_radius_small"
                    app:strokeColor="#40c8102e"
                    android:textColor="@color/sysu_red"
                    app:rippleColor="#20c8102e" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════
         "MY QUEUE" SECTION LABEL
         TOP anchor: cardQueueStatus bottom
         BOTTOM: free (only participates in top chain)
         ══════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvMyQueueLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp"
        android:text="MY QUEUE"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="@font/atkinson_hyperlegible_bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/cardQueueStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════
         CTA NOTIFICATION CARD — PINNED above bottom nav.
         This is the BOTTOM ANCHOR for the entire middle chain.
         NO top constraint → bottom-only anchor pins it in place.
         All middle content lives ABOVE this card.
         ══════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScanCTA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="@dimen/corner_radius_pill"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="1dp"
        app:strokeColor="#F0F0F0"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCloseScanCTA"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close notification"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            android:elevation="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/ctaStatusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/tvStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cta_status_scan"
                    android:textAppearance="@style/TextAppearance.Sysu.CTA.StatusPill"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCTAHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cta_header_scan"
                android:textAppearance="@style/TextAppearance.Sysu.CTA.Header" />

            <TextView
                android:id="@+id/tvCTABody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/text_max_width"
                android:text="@string/cta_body_scan"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Sysu.CTA.Body"
                android:layout_marginTop="4dp" />

            <ImageView
                android:id="@+id/ivBounceArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_down"
                android:layout_marginTop="4dp"
                app:tint="@color/sysu_red" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════
         SHIPMENT CARDS RecyclerView (Phase 2: 2+ shipments)
         GONE by default. VISIBLE when currentShipments.size >= 2.

         TOP:    tvMyQueueLabel bottom
         BOTTOM: cardScanCTA top
         → Both anchors stay valid regardless of cardMyQueue GONE/VISIBLE.
         → height="0dp" + constraintHeight_max="240dp" = internal scroll.
         ══════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShipmentCards"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvMyQueueLabel"
        app:layout_constraintBottom_toTopOf="@id/cardScanCTA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="320dp"
        app:layout_constraintVertical_bias="0.0" />

    <!-- ══════════════════════════════════════════════
         ALL SHIPMENTS COMPLETE STATE
         Hidden by default. Shown when all shipments have tripStatus == "completed".
         Replaces shipment cards in the same constraint space.
         ══════════════════════════════════════════════ -->
    <include
        android:id="@+id/myQueueCompleteSection"
        layout="@layout/layout_my_queue_complete"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvMyQueueLabel"
        app:layout_constraintBottom_toTopOf="@id/cardScanCTA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════
         MY QUEUE SECTION — Full queue detail view
         Replaces cardMyQueue — same constraint anchors.
         Visibility controlled by showMyQueueSection() / updateQueueTabs().
         cardMyQueue kept in DOM (visibility="gone") as fallback.
         ══════════════════════════════════════════════ -->
    <include
        android:id="@+id/myQueueSection"
        layout="@layout/my_queue_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMyQueueLabel"
        app:layout_constraintBottom_toTopOf="@id/cardScanCTA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <!-- cardMyQueue — kept as minimal empty shell (visibility gone).
         The myQueueSection include above replaces it for the queue-display use case.
         Kept only to preserve anchor chain: top→@id/tvMyQueueLabel, bottom→@id/cardScanCTA.
         tvQueueDetails placeholder ensures updateQueueUI() binding compiles. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMyQueue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvMyQueueLabel"
        app:layout_constraintBottom_toTopOf="@id/cardScanCTA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/tvQueueDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap scan button to join"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:padding="20dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════
         SCAN HINT — shown when NOT in queue.
         Hidden by visibility="gone" (Kotlin controls it).
         Anchored to cardScanCTA so it disappears with the CTA.
         ══════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvScanHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_hint_chip"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="Ipakita ang QR code sa booth para mag-check in"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_size_body"
        android:fontFamily="@font/atkinson_hyperlegible_regular"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cardScanCTA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════
         BOTTOM NAV — 100dp, pinned to screen bottom.
         QR FAB centered with pulse rings that bleed upward.
         ══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:elevation="@dimen/elevation_floating"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/divider"
            app:layout_constraintTop_toTopOf="@id/bottomNav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivHome"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/home1"
                    app:tint="@color/sysu_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/sysu_red"
                    android:fontFamily="@font/atkinson_hyperlegible_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/profile1"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/atkinson_hyperlegible_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/scanButtonContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/pulseRing1"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse_ring"
                android:alpha="0" />

            <View
                android:id="@+id/pulseRing2"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse_ring"
                android:alpha="0" />

            <ImageView
                android:id="@+id/btnScanQR"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:src="@drawable/qr_icon"
                android:elevation="12dp"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         QR TUTORIAL OVERLAY — full screen, elevation 20dp
         ══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/qrTutorialOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_qr_code_custom"
                        app:tint="@color/sysu_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Paano Mag-Check In"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="I-tap ang QR button sa ibaba, pagkatapos ay itutok ang camera sa QR code na nasa TV screen."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_label"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="4dp" />

                    <CheckBox
                        android:id="@+id/cbQrTutorialDontShow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Wag na itong ipakita ulit"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGotIt"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Nakuha Ko Na!"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_button"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/sysu_red"
                        app:cornerRadius="@dimen/corner_radius_button"
                        app:elevation="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- My Trip Tab — toggled visible/invisible by navMapIcon click -->
    <FrameLayout
        android:id="@+id/myTripTabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/background_white"
        app:layout_constraintTop_toBottomOf="@id/redHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/layout_my_trip_tab" />

    </FrameLayout>

    <!-- ══════════════════════════════════════════════
         NAVBAR TUTORIAL OVERLAY — first-time only, elevation 22dp
         ══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/navTutorialOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="22dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Tutorial popover card — anchored near bottom nav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="120dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#F0F0F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iyong Navbar"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_title"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Ito ang ginagawa ng bawat button para madali kang makalibot."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_label"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="3dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/border" />

                    <!-- Home -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/home1"
                            app:tint="@color/sysu_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home — Aking Pila"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_body"
                                android:fontFamily="@font/atkinson_hyperlegible_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dito lumalabas ang mga naka-assign na shipment"
                                android:textColor="@color/text_muted"
                                android:textSize="@dimen/text_size_caption"
                                android:fontFamily="@font/atkinson_hyperlegible_regular" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- QR Scan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/qr_icon"
                            app:tint="@color/sysu_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QR — Mag-Check In sa Booth"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_label"
                                android:fontFamily="@font/atkinson_hyperlegible_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mag-scan para makapasok sa pila at makuha ang assignment"
                                android:textColor="@color/text_muted"
                                android:textSize="@dimen/text_size_caption"
                                android:fontFamily="@font/atkinson_hyperlegible_regular" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Profile -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/profile1"
                            app:tint="@color/text_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profile — Account at Settings"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_label"
                                android:fontFamily="@font/atkinson_hyperlegible_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tingnan at baguhin ang iyong driver profile"
                                android:textColor="@color/text_muted"
                                android:textSize="@dimen/text_size_caption"
                                android:fontFamily="@font/atkinson_hyperlegible_regular" />
                        </LinearLayout>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cbNavTutorialDontShow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Wag na itong ipakita ulit"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavTutorialDone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Nakuha Ko Na!"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_button"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/sysu_red"
                        app:cornerRadius="@dimen/corner_radius_button"
                        app:elevation="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>