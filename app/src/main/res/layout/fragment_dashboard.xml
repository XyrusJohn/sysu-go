<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding_horizontal"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:text="Go"
        android:textColor="#c8102e"
        android:gravity="center"
        />

    <Button
        android:id="@+id/btnStartTrip"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Start Trip"
        android:textColor="#FFFFFF"
        android:backgroundTint="#c8102e"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvNetworkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking Status..."
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="10dp"
        android:padding="@dimen/card_spacing"
        />

    <TextView
        android:id="@+id/tvDriverId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Driver ID: --"
        android:textColor="#666666"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location: Waiting..."
        android:textColor="#666666"
        android:layout_marginTop="20dp"
        />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/logout"
        android:textColor="#c8102e"
        android:layout_marginTop="20dp"
        style="@style/Widget.Material3.Button.TextButton"/>
</LinearLayout>