<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header with Dynamic Circles -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@color/sysu_red"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/circleContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="@id/headerBackground"
        app:layout_constraintTop_toTopOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground" />

    <!-- White Back Button on Red Header -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/section_spacing"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Back" />

    <TextView
        android:id="@+id/tvDriverDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/atkinson_hyperlegible_bold"
        android:text="@string/register_driver_details"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_headline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvStepInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/atkinson_hyperlegible_regular"
        android:text="@string/register_step_1_of_2"
        android:textColor="#E0E0E0"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintStart_toStartOf="@id/tvDriverDetails"
        app:layout_constraintTop_toBottomOf="@id/tvDriverDetails" />

    <!-- Step Indicator -->
    <LinearLayout
        android:id="@+id/stepIndicatorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvStepInfo">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <View
                android:id="@+id/indicatorDetails"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Details"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/atkinson_hyperlegible_bold"/>
        </LinearLayout>

        <View android:layout_width="12dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <View
                android:id="@+id/indicatorConfirm"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#60FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confirm"
                android:textColor="#B0FFFFFF"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/atkinson_hyperlegible_bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Form Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/stepIndicatorRow"
        app:layout_constraintBottom_toTopOf="@id/bottomActionContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_top_rounded_white">

            <!-- Last Name -->
            <TextView
                android:id="@+id/lblLastName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Name"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Dela Cruz"
                android:textColorHint="#9E9E9E"
                android:paddingHorizontal="16dp"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/black"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/lblLastName" />

            <!-- First Name -->
            <TextView
                android:id="@+id/lblFirstName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="First Name"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                app:layout_constraintTop_toBottomOf="@id/etLastName"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Juan"
                android:textColorHint="#9E9E9E"
                android:paddingHorizontal="16dp"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/black"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/lblFirstName" />

            <!-- MI and Password (labeled Phone in hint) Row -->
            <LinearLayout
                android:id="@+id/rowMiddlePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/etFirstName">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Middle Initial"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="@font/atkinson_hyperlegible_bold" />
                    <EditText
                        android:id="@+id/etMiddleInitial"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:hint="e.g. P"
                        android:textColorHint="#9E9E9E"
                        android:maxLength="1"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/black"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="16dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.8"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile Number"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="@font/atkinson_hyperlegible_bold" />
                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="phone"
                        android:hint="e.g. 09123456789"
                        android:textColorHint="#9E9E9E"
                        android:paddingHorizontal="16dp"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/black"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Truck Company -->
            <TextView
                android:id="@+id/lblTruck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Truck Company"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                app:layout_constraintTop_toBottomOf="@id/rowMiddlePhone"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTruckCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_business"
                app:startIconTint="#757575"
                app:endIconMode="dropdown_menu"
                app:layout_constraintTop_toBottomOf="@id/lblTruck">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvTruckCompany"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="JR&amp;R DISTRIBUTORS Inc."
                    android:textColorHint="#9E9E9E"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/black"
                    android:fontFamily="@font/atkinson_hyperlegible_bold"
                    android:textStyle="bold"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPhoneVerified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:visibility="gone"
                android:text="Please review your details before confirming."
                android:textColor="@color/sysu_gold"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/atkinson_hyperlegible_regular"
                app:layout_constraintTop_toBottomOf="@id/tilTruckCompany" />

            <!-- Dummy views to keep IDs for logic -->
            <View android:id="@+id/phoneVerifySection" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <View android:id="@+id/ivPhoneVerified" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <View android:id="@+id/btnSendOtp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:fontFamily="@font/atkinson_hyperlegible_bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="-46dp"
            android:visibility="gone"
            android:indeterminateTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
