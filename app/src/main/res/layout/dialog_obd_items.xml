<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OBD  ITEMS"
            android:textColor="@color/sysu_red"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvObdSheetCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_obd_count_pill"
            android:paddingHorizontal="11dp"
            android:paddingVertical="3.5dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Spacer -->
        <View
            android:layout_width="24dp"
            android:layout_height="0dp" />

    </LinearLayout>

    <!-- White card with table — full width table, no horizontal scroll -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Red top brand bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:background="@color/sysu_red" />

            <!-- Data scroll area -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <!-- Loading / refreshing spinner -->
                    <ProgressBar
                        android:id="@+id/pbObdRefresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="48dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/tvObdSheetEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="40dp"
                        android:text="No items to display"
                        android:textColor="@color/text_muted"
                        android:textStyle="italic"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone" />

                    <!-- Dynamic rows container -->
                    <LinearLayout
                        android:id="@+id/llObdSheetContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>