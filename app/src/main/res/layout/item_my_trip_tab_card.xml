<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="@dimen/corner_radius_pill"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Red brand bar at top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:background="@color/sysu_red" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Shipment Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ticket_1"
                    app:tint="@color/sysu_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/atkinson_hyperlegible_regular"
                    android:text="Shipment"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvShipmentNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider" />

            <!-- Plate No -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PLATE NO."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvPlateNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <!-- Truck Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRUCK TYPE"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvTruckType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <!-- Helper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HELPER"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvHelper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <!-- Planned Delivery Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PLANNED DELIVERY"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvDeliveryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider" />

            <!-- Guard Verified Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GUARD VERIFIED"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <!-- Guard pill -->
                <LinearLayout
                    android:id="@+id/guardPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill_green"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/guardPillDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_dot_green" />

                    <TextView
                        android:id="@+id/tvGuardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@android:color/transparent"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Driver Confirmed Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DRIVER CONFIRMED"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:id="@+id/driverPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/driverPillDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_dot_green" />

                    <TextView
                        android:id="@+id/tvDriverStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@android:color/transparent"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- OBD count section — clickable card surface -->
            <LinearLayout
                android:id="@+id/rowObd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_obd_row_surface"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    android:text="OBD ITEMS"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <!-- Count as visible badge pill -->
                <TextView
                    android:id="@+id/tvObdCount"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:minWidth="20dp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:background="@drawable/bg_obd_count_pill"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <!-- POD pending badge — hidden when all items have POD -->
                <TextView
                    android:id="@+id/tvPodPending"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:background="@drawable/bg_pod_pending_pill"
                    android:textColor="@color/transit_amber_dark"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2 pending"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivObdChevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ticket"
                    android:contentDescription="View OBD details"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider" />

            <!-- Customer Requirements Compact Table -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMER REQUIREMENTS"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Column 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_aircon"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aircon" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqAircon" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_vest"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reflect. Vest" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqVest" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_headcap"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Headcap" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqHeadcap" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Column 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_safety_shoes"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Safety Shoes" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqSafetyShoes" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_pants"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pants" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqPants" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_req_shoes"
                            app:tint="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Closed Shoes" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:id="@+id/tvReqClosedShoes" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Trip Status Badge (replaces the action row pill from assignment) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sysu_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STATUS"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvTripStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:background="@drawable/bg_status_pill_gray"
                    tools:text="CONFIRMED" />
            </LinearLayout>

            <!-- Dual Button Section: Primary (top) +Secondary (bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Primary Action (state-driven) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTripAction"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:text="START TRIP"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_button"
                    android:fontFamily="@font/atkinson_hyperlegible_bold"
                    android:textStyle="bold"
                    app:elevation="4dp"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@color/sysu_red"
                    app:cornerRadius="@dimen/corner_radius_button" />

                <!-- Show Verification button — visible only when guard is verified but verification not yet shown -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowVerification"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="8dp"
                    android:text="SHOW VERIFICATION"
                    android:textAllCaps="false"
                    android:textColor="@color/sysu_red"
                    android:textSize="@dimen/text_size_button"
                    android:fontFamily="@font/atkinson_hyperlegible_bold"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:elevation="4dp"
                    app:strokeWidth="1.5dp"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/sysu_red"
                    app:cornerRadius="@dimen/corner_radius_button" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>