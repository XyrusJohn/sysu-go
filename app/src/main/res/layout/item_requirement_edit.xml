<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_req_aircon"
        app:tint="@color/text_muted"
        android:contentDescription="requirement icon" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Requirement"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_size_label"
        android:fontFamily="@font/atkinson_hyperlegible_regular" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbRequirement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/sysu_red"
        android:minWidth="0dp"
        android:minHeight="0dp" />

</LinearLayout>