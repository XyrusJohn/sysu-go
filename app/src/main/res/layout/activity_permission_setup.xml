<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ── Header: SYSU red + bouncing circles ── -->
    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/sysu_red"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Bounce circle 1 — big white, top-left overflow -->
        <View
            android:id="@+id/bounceCircle1"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginStart="-50dp"
            android:layout_marginTop="-70dp"
            android:background="@drawable/bg_bounce_circle_white"
            android:alpha="0.10"
            android:tag="bounce" />

        <!-- Bounce circle 2 — gold, top-right overflow -->
        <View
            android:id="@+id/bounceCircle2"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-30dp"
            android:background="@drawable/bg_bounce_circle_gold"
            android:alpha="0.18"
            android:tag="bounce" />

        <!-- Bounce circle 3 — dark red, bottom-right -->
        <View
            android:id="@+id/bounceCircle3"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_bounce_circle_dark"
            android:alpha="0.45"
            android:tag="bounce" />

        <!-- Bounce circle 4 — small white, mid-left -->
        <View
            android:id="@+id/bounceCircle4"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="80dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_bounce_circle_white"
            android:alpha="0.20"
            android:tag="bounce" />

        <!-- Header content stacked on top of circles -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="0dp">

            <!-- Logo mark -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="120dp"
                android:layout_height="34dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/logo_sysu"
                android:scaleType="fitStart"
                android:contentDescription="SYSU Logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/screen_padding_horizontal" />

            <!-- Step counter -->
            <TextView
                android:id="@+id/tvStepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#FFCCCCCC"
                android:textSize="11.5sp"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                tools:text="Step 1 of 3"
                app:layout_constraintTop_toBottomOf="@id/ivLogo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/screen_padding_horizontal" />

            <!-- Step dots -->
            <LinearLayout
                android:id="@+id/stepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="@id/tvStepCounter"
                app:layout_constraintBottom_toBottomOf="@id/tvStepCounter"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/screen_padding_horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/perm_setup_title"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold"
                android:includeFontPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tvStepCounter"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/screen_padding_horizontal" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/perm_setup_subtitle"
                android:textColor="#BBCCCCCC"
                android:textSize="13.5sp"
                android:fontFamily="@font/atkinson_hyperlegible_regular"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Anchor for content below header -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerBar" />

    <!-- ── Permission list ── -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/headerBottomBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomArea">

        <LinearLayout
            android:id="@+id/permissionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- ── Location item ── -->
            <LinearLayout
                android:id="@+id/itemLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_perm_card"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/accentLocation"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/accent_required" />

                <FrameLayout
                    android:id="@+id/iconLocation"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginVertical="14dp"
                    android:background="@drawable/bg_perm_icon_gray">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_location_crosshairs"
                        app:tint="#999999" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/perm_loc_name"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required"
                            android:textSize="11sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:textColor="@color/white"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_required" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/perm_loc_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <TextView
                        android:id="@+id/hintLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/perm_loc_hint_body"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronLocation"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#CCCCCC"
                    android:contentDescription="Expand hint" />
            </LinearLayout>

            <!-- ── Notification item ── -->
            <LinearLayout
                android:id="@+id/itemNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_perm_card"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/accentNotification"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/accent_required" />

                <FrameLayout
                    android:id="@+id/iconNotification"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginVertical="14dp"
                    android:background="@drawable/bg_perm_icon_gray">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        app:tint="#999999" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/perm_notif_name"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipNotification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required"
                            android:textSize="11sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:textColor="@color/white"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_required" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/perm_notif_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <TextView
                        android:id="@+id/hintNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/perm_notif_hint_body"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronNotification"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#CCCCCC"
                    android:contentDescription="Expand hint" />
            </LinearLayout>

            <!-- ── Battery item ── -->
            <LinearLayout
                android:id="@+id/itemBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_perm_card"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/accentBattery"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/accent_required" />

                <FrameLayout
                    android:id="@+id/iconBattery"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginVertical="14dp"
                    android:background="@drawable/bg_perm_icon_gray">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_battery"
                        app:tint="#999999" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/perm_battery_name"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required"
                            android:textSize="11sp"
                            android:fontFamily="@font/atkinson_hyperlegible_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:textColor="@color/white"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_required" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/perm_battery_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <TextView
                        android:id="@+id/hintBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/perm_battery_hint_body"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronBattery"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#CCCCCC"
                    android:contentDescription="Expand hint" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom CTA ── -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantAll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/perm_enable_all"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/perm_skip"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Shadow above bottom area -->
    <View
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="@drawable/bottom_shadow"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Success overlay ── -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5FFFE"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_success_circle" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#4CAF50" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/perm_all_done"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_redirecting"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/atkinson_hyperlegible_regular" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_pulse"
                    android:tag="pulse" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/dot_pulse"
                    android:tag="pulse" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/dot_pulse"
                    android:tag="pulse" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>