<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="@dimen/corner_radius_small"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surface2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingEnd="14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Red left accent bar — matches existing OBD row pattern -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/sysu_red" />

        <!-- OBD number + customer name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/tvObdNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                tools:text="6051555386" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:ellipsize="middle"
                android:maxLines="1"
                tools:text="Juan dela Cruz — 123 Adel St." />
        </LinearLayout>

        <!-- Quantity -->
        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="36dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="229" />

        <!-- Delivery status pill — color-coded -->
        <TextView
            android:id="@+id/tvDeliveryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            tools:text="PENDING"
            tools:textColor="@color/text_amber"
            tools:background="@color/amber_pill_bg" />

        <!-- POD indicator — camera when pending, checkmark or preview thumbnail when completed -->
        <ImageView
            android:id="@+id/ivPodIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_camera_pod"
            android:contentDescription="POD photo captured"
            android:visibility="gone"
            tools:visibility="visible"
            app:tint="@color/transit_green" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>