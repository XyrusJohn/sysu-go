<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ============================================================
         HEADER â€” stays above everything (z-index: 2)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="@dimen/elevation_floating"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Queue"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to depart"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- ============================================================
         BANNER + CARD OVERLAP ZONE â€” FrameLayout controls explicit z-order
         z-index 0 (bottom, drawn first): queueNumberBanner
         z-index 1 (top, drawn second):  cardDetails
         ============================================================ -->
    <FrameLayout
        android:id="@+id/bannerCardStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Red Banner with Queue Number â€” z-index: 0 (bottom layer) -->
        <FrameLayout
            android:id="@+id/queueNumberBanner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_height"
            android:background="@color/sysu_red"
            android:elevation="0dp">

            <!-- Animated floating circles â€” populated programmatically -->
            <FrameLayout
                android:id="@+id/circleContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Queue number CONTENT â€” sits BELLOW normal, so card can overlap on top -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvQueueNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUEUE NUMBER"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_title"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvQueueNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_queue_number"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Details Card â€” z-index: 1 (top layer, overlaps bottom of banner)
             The Shipment Number row sits ABOVE the queue number visual space. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="180dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <!-- Shipment Number Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SHIPMENT NUMBER"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvShipmentNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="-"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <!-- Plate No Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PLATE NO."
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlateNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="ABC 1234"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <!-- Truck Type Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TRUCK TYPE"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTruckType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="AUV"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <!-- Helper Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HELPER"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHelper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Pedro Santos"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- ─── Divider ─── -->
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <!-- ─── CUSTOMER REQUIREMENTS TABLE ─── -->
                <!-- 3-column compact grid: Equip | Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <!-- Section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUSTOMER REQUIREMENTS"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="10dp" />

                    <!-- Requirements grid: 2 rows of 3 items each -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Column 1: Aircon, Reflectorized Vest, Headcap -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Aircon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_aircon"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Aircon"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqAircon"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Reflectorized Vest -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_vest"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Reflect. Vest"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqVest"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Headcap -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_headcap"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Headcap"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqHeadcap"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Column 2: Safety Shoes, Pants, Closed Shoes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Safety Shoes -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_safety_shoes"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Safety Shoes"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqSafetyShoes"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Pants -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_pants"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Pants"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqPants"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Closed Shoes -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="5dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_req_shoes"
                                    app:tint="@color/text_secondary" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Closed Shoes"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/atkinson_hyperlegible_regular" />
                                <TextView
                                    android:id="@+id/tvReqClosedShoes"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="—"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ─── Divider ─── -->
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <!-- Planned Delivery Date / Time Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PLANNED DELIVERY"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />

                    <TextView
                        android:id="@+id/tvDeliveryDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- ========== SCROLLING CONTENT SECTION ========== -->
    <!-- Whole page scrolls below the red banner â€” headers stay fixed, content scrolls -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        app:layout_constraintTop_toBottomOf="@id/bannerCardStack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================================
                 OBD ITEMS â€” TAPPABLE HEADER CARD
                 Opens floating bottom sheet on tap.
                 ============================================================ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardObdItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Red top brand bar -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3.5dp"
                        android:background="@color/sysu_red" />

                    <!-- Clickable header row: OBD ITEMS label + count pill + expand chevron -->
                    <LinearLayout
                        android:id="@+id/obdTableHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OBD  ITEMS"
                            android:textColor="@color/sysu_red"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold"
                            android:letterSpacing="0.07" />

                        <TextView
                            android:id="@+id/tvObdCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_obd_count_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3.5dp"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <!-- Expand chevron -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/text_muted"
                            android:contentDescription="Open OBD items" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom padding so content doesn't hide behind nav bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

            
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>