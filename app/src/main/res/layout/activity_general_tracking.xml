<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <!-- ══════════════════════════════════════════════
         TOP BAR
    ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:letterSpacing="0.1"
            android:text="TRIP TRACKING"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ══════════════════════════════════════════════
         RED STATUS HEADER — fixed padding & sizing
    ════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/redHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_red_header_rounded_bottom"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <!-- ═══ BOUNCING CIRCLES CONTAINER — fills entire red header ═══ -->
        <FrameLayout
            android:id="@+id/circleContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />

        <!-- ══ TEXT CONTENT — on top of circles ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE TRIP STATUS"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_size_caption"
                android:letterSpacing="0.12"
                android:fontFamily="@font/atkinson_hyperlegible_regular" />

            <!-- Big ON/OFF readout -->
            <TextView
                android:id="@+id/tvTrackingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tracking: OFF"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textStyle="bold" />

            <!-- Socket connection pill — wider, full text visible -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/socketPillCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <View
                        android:id="@+id/socketStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" />

                    <TextView
                        android:id="@+id/tvSocketStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Socket: Disconnected"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:fontFamily="@font/atkinson_hyperlegible_bold"
                        android:maxLines="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         GPS LOCATION CARD
    ════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-24dp"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/redHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/wait"
                app:tint="@color/sysu_red"
                android:alpha="0.85" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT GPS LOCATION"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/atkinson_hyperlegible_regular" />

                <TextView
                    android:id="@+id/tvCurrentLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Location: Waiting for GPS..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/atkinson_hyperlegible_bold" />

                <!-- ═══ NEW: TELEMETRY ROW (GPS Accuracy & Network Status) ═══ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <!-- GPS Signal Dot & Text -->
                    <View
                        android:id="@+id/dotGpsSignal"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" />
                    <TextView
                        android:id="@+id/tvGpsAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="GPS: Searching..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />

                    <!-- Spacer -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Network Status Dot & Text -->
                    <View
                        android:id="@+id/dotNetworkStatus"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" />
                    <TextView
                        android:id="@+id/tvNetworkStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Network: Checking..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/atkinson_hyperlegible_regular" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════
         SCROLLABLE ACTION AREA
    ════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/cardLocation"
        app:layout_constraintBottom_toTopOf="@id/floatingBottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRIP CONTROLS"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:letterSpacing="0.1"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:layout_marginBottom="14dp" />

            <!-- Start Tracking — filled red button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartTracking"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:text="Start Tracking"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/sysu_red"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textSize="@dimen/text_size_button"
                app:cornerRadius="@dimen/corner_radius_button" />

            <!-- End Trip — outlined amber button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndTracking"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:text="End Trip"
                android:layout_marginBottom="12dp"
                android:textColor="@color/sysu_amber"
                android:textAllCaps="false"
                android:fontFamily="@font/atkinson_hyperlegible_bold"
                android:textSize="@dimen/text_size_button"
                app:cornerRadius="@dimen/corner_radius_button"
                app:strokeColor="@color/sysu_amber"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════
         FLOATING BOTTOM BAR
    ════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/floatingBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="12dp"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIPMENT READY"
                android:textColor="@color/sysu_red"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />

            <TextView
                android:id="@+id/tvBatchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cannot Start trip without Selecting a Customer"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/atkinson_hyperlegible_bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectActiveTrip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:text="Piliin ang Active Trip"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:textSize="13sp"
            android:paddingHorizontal="18dp"
            app:backgroundTint="@color/sysu_red"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>