<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_helper_card_simple"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Helper Label + Remove button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHelperLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/atkinson_hyperlegible_bold"
            android:text="Helper 1"
            android:textColor="@color/sysu_red"
            android:textSize="@dimen/text_size_label"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRemoveHelper"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove Helper"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- First Name (full width) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHelperFN"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="First Name"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHelperFN"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:fontFamily="@font/atkinson_hyperlegible_regular"
            android:inputType="textPersonName"
            android:maxLength="50"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- MI + Last Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHelperMI"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:hint="MI"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHelperMI"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:fontFamily="@font/atkinson_hyperlegible_regular"
                android:gravity="center"
                android:inputType="textCapCharacters"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHelperLN"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Last Name"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHelperLN"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:fontFamily="@font/atkinson_hyperlegible_regular"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>