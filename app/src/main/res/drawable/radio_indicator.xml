<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom radio indicator drawable.
    Unchecked: hollow circle with gray border.
    Checked: hollow circle with gray border + filled red center dot.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.5dp" android:color="@color/sysu_red" />
                    <solid android:color="@android:color/transparent" />
                    <size android:width="18dp" android:height="18dp" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/sysu_red" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.5dp" android:color="@color/text_muted" />
                    <solid android:color="@android:color/transparent" />
                    <size android:width="18dp" android:height="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>