# Safe local emulator configuration; never paste real credentials into this file.
PORT=3001
NODE_ENV=development
SYSU_ENV=emulator
FIREBASE_PROJECT_ID=demo-sysu-security
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: configure these in the hosting platform, with emulator variables unset.
# SYSU_ENV=production
# NODE_ENV=production
# FIREBASE_PROJECT_ID=sysu-web-5a25d
# ALLOWED_ORIGINS=https://sysu-web-5a25d.web.app
# FIREBASE_SERVICE_ACCOUNT_JSON=<replacement credential JSON from the release owner>
