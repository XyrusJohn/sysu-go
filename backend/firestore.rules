rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Any authenticated user can update their own profile (including role for Super Admin)
      // Non-role changes for all users, role changes should go through role_request workflow
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Role change requests
    // TODO: restrict to admin/super_admin only via custom claim (not set up yet)
    // For now, allow all authenticated users to read/write
    match /role_requests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Queue - Public read for Command Center
    match /queue/{queueId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Drivers - Public read for Dashboard maps
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // SAP Assignments
    match /sap_assignments/{shipmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Truck Companies — public read for driver registration dropdown
    match /truck_company/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    // Security Guards — public read for guard verification dropdown
    match /security_guard/{guardId} {
      allow read: if true;
      allow write: if false;
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if request.auth != null
                  && (resource.data.reporterId == request.auth.uid
                      || !resource.data.keys().hasAll(['reporterId']));
      allow create: if request.auth != null && resource.data.reporterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reporterId == request.auth.uid;
    }

    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}