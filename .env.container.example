# Copy this file to .env and replace deployment-specific values.
NODE_ENV=production
SYSU_ENV=staging
PORT=8080
HOST_PORT=8080
FIREBASE_PROJECT_ID=your-staging-firebase-project-id
ALLOWED_ORIGINS=https://your-dashboard.example.com
# Supply FIREBASE_SERVICE_ACCOUNT_JSON via the host's secret manager.
# SYSU Go's backend requires a matching service-account JSON outside emulator mode.
# Never commit a real service account or private key.
